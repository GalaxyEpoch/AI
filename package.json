{
  "name": "galaxyepoch",
  "version": "1.0.0",
  "description": "开源大模型聚合客户端 - 轻量化、易部署、永久开源免费",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "AI",
    "LLM",
    "Ollama",
    "ChatGPT",
    "开源",
    "聚合客户端"
  ],
  "author": "GalaxyEpoch Team",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.12"
  },
  "build": {
    "appId": "com.galaxyepoch.app",
    "productName": "GalaxyEpoch",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false,
      "forceCodeSigning": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
